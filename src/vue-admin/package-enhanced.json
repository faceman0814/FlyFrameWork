{
  "name": "vue-admin",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:staging": "vite build --mode staging",
    "build:prod": "vite build --mode production",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/",
    "generate-api": "nswag run nswag.json",
    "dev:with-api": "npm run generate-api && npm run dev",
    "build:with-api": "npm run generate-api && npm run build",
    "api:check": "curl -f http://localhost:6298/swagger/v1/swagger.json || echo 'Backend API is not available'",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "type-check": "vue-tsc --noEmit",
    "docker:build": "docker build -t vue-admin .",
    "docker:run": "docker run -p 3000:80 vue-admin",
    "docker:dev": "docker-compose -f docker-compose.yml up -d",
    "docker:prod": "docker-compose -f docker-compose.prod.yml up -d",
    "deploy:dev": "bash scripts/deploy.sh dev",
    "deploy:staging": "bash scripts/deploy.sh staging", 
    "deploy:prod": "bash scripts/deploy.sh prod",
    "health-check": "curl -f http://localhost:3000/health",
    "analyze": "vite-bundle-analyzer",
    "clean": "rimraf dist node_modules/.vite",
    "prepare": "husky install"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.1.0",
    "@vueuse/core": "^10.2.1",
    "axios": "^1.4.0",
    "element-plus": "^2.3.8",
    "js-cookie": "^3.0.5",
    "nprogress": "^0.2.0",
    "nswag": "^14.5.0",
    "pinia": "^2.1.6",
    "vue": "^3.3.4",
    "vue-i18n": "^9.2.2",
    "vue-router": "^4.2.4",
    "@sentry/vue": "^7.114.0",
    "@sentry/tracing": "^7.114.0",
    "web-vitals": "^3.5.0"
  },
  "devDependencies": {
    "@types/js-cookie": "^3.0.3",
    "@types/node": "^20.4.5",
    "@types/nprogress": "^0.2.0",
    "@types/path-browserify": "^1.0.3",
    "@typescript-eslint/eslint-plugin": "^6.2.0",
    "@typescript-eslint/parser": "^6.2.0",
    "@vitejs/plugin-vue": "^4.2.3",
    "@vue/test-utils": "^2.4.1",
    "eslint": "^8.45.0",
    "eslint-plugin-vue": "^9.15.1",
    "happy-dom": "^12.10.3",
    "path-browserify": "^1.0.1",
    "prettier": "^3.0.0",
    "sass": "^1.64.1",
    "typescript": "^5.1.6",
    "unplugin-auto-import": "^0.16.6",
    "unplugin-vue-components": "^0.25.1",
    "vite": "^4.4.5",
    "vitest": "^1.0.4",
    "@vitest/ui": "^1.0.4",
    "@vitest/coverage-v8": "^1.0.4",
    "vue-tsc": "^1.8.5",
    "husky": "^8.0.3",
    "lint-staged": "^15.0.2",
    "rimraf": "^5.0.5",
    "vite-bundle-analyzer": "^0.7.0"
  }
}