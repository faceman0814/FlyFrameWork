# 忽略依赖文件
node_modules/
pnpm-lock.yaml
yarn.lock
package-lock.json

# 忽略构建产物
dist/
build/
*.tsbuildinfo

# 忽略日志文件
*.log
logs/

# 忽略环境变量文件
.env
.env.local
.env.*.local

# 忽略编辑器和IDE配置
.vscode/
.idea/
*.swp
*.swo
*~

# 忽略操作系统文件
.DS_Store
Thumbs.db

# 忽略临时文件
*.tmp
*.temp

# 忽略自动生成的文件
auto-imports.d.ts
components.d.ts