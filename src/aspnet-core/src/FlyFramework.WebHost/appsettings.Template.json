{
  "ConnectionStrings": {
    "DatabaseType": "Postgre",
    "Default": "Host=<host>;Port=5432;Database=<db>;Username=<user>;Password=<password>"
  },
  "CorsOrigins": "http://localhost:8080",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "System": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "JwtBearer": {
    "SecretKey": "<generate-strong-random>",
    "Issuer": "FlyFrameWork",
    "Audience": "FlyFrameWork"
  },
  "Redis": {
    "Host": "<host>",
    "Port": 6379,
    "Password": "<password>",
    "Enable": false,
    "SSL": true,
    "PreName": "FlyFrameWork-",
    "Db": 0
  },
  "Minio": {
    "Endpoint": "<host>:<port>",
    "AccessKey": "<ak>",
    "SecretKey": "<sk>",
    "BucketName": "flyframework",
    "Enable": false,
    "Secure": false
  },
  "HangFire": {
    "Enable": false
  },
  "RabbitMq": {
    "HostName": "<host>",
    "Port": 5672,
    "UserName": "<user>",
    "Password": "<password>",
    "Enable": false
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteToConsole": true,
    "WriteToFile": true,
    "FilePath": "App_Data/Log/log-.txt"
  }
}

